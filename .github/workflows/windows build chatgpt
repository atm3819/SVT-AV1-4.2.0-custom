```yaml
name: PGO Build with Clang (Windows x86-64)

on:
  workflow_dispatch:

jobs:
  pgo-build-windows-x86-64:
    runs-on: windows-latest

    env:
      CC: clang
      CXX: clang++
      CMAKE_BUILD_TYPE: Release

    steps:
      # ------------------------------------------------------------
      # Checkout
      # ------------------------------------------------------------
      - name: Checkout repository
        uses: actions/checkout@v4

      # ------------------------------------------------------------
      # LLVM / Clang
      # ------------------------------------------------------------
      - name: Install LLVM/Clang
        uses: egor-tensin/setup-clang@v1
        with:
          version: latest
          platform: x64

      # ------------------------------------------------------------
      # NASM
      # ------------------------------------------------------------
      - name: Install NASM
        uses: ilammy/setup-nasm@v1

      # ------------------------------------------------------------
      # Ninja
      # ------------------------------------------------------------
      - name: Install Ninja
        shell: pwsh
        run: |
          choco install ninja -y
          ninja --version

      # ------------------------------------------------------------
      # Show toolchain versions
      # ------------------------------------------------------------
      - name: Show toolchain
        shell: pwsh
        run: |
          clang --version
          clang++ --version
          cmake --version
          ninja --version
          llvm-profdata --version

      # ------------------------------------------------------------
      # Download PGO training video
      # ------------------------------------------------------------
      - name: Download test Y4M video
        shell: pwsh
        run: |
          $videoDir = Join-Path $PWD "build\videos"
          $video = Join-Path $videoDir "park_joy_420_720p50.y4m"

          New-Item -ItemType Directory -Force -Path $videoDir | Out-Null

          $url = "https://media.xiph.org/video/derf/y4m/park_joy_420_720p50.y4m"

          Write-Host "Downloading PGO training video..."
          Write-Host "URL: $url"
          Write-Host "Output: $video"

          try {
              Invoke-WebRequest `
                -Uri $url `
                -OutFile $video `
                -UseBasicParsing

              $file = Get-Item $video -ErrorAction Stop

              if ($file.Length -lt 1000000) {
                  throw "Downloaded file is unexpectedly small: $($file.Length) bytes"
              }

              Write-Host "Download successful."
              Write-Host "Size: $($file.Length) bytes"
          }
          catch {
              Write-Warning "Video download failed."
              Write-Warning $_.Exception.Message
          }

      # ------------------------------------------------------------
      # Synthetic fallback video
      #
      # This is only used if the real training video could not
      # be downloaded.
      # ------------------------------------------------------------
      - name: Create synthetic Y4M fallback
        shell: pwsh
        run: |
          $video = Join-Path $PWD "build\videos\park_joy_420_720p50.y4m"

          if (Test-Path $video) {
              Write-Host "Training video already exists."
              exit 0
          }

          Write-Warning "Creating synthetic fallback Y4M."

          $header = [System.Text.Encoding]::ASCII.GetBytes(
              "YUV4MPEG2 W=640 H=360 F=30:1 Ip A0:0 C420jpeg`n"
          )

          $frameHeader = [System.Text.Encoding]::ASCII.GetBytes("FRAME`n")

          # 640x360 YUV420:
          # Y = 230400 bytes
          # U = 57600 bytes
          # V = 57600 bytes
          $y = [byte[]](0..230399 | ForEach-Object { 128 })
          $u = [byte[]](0..57599  | ForEach-Object { 128 })
          $v = [byte[]](0..57599  | ForEach-Object { 128 })

          $stream = [System.IO.File]::OpenWrite($video)

          try {
              $stream.Write($header, 0, $header.Length)

              for ($frame = 0; $frame -lt 30; $frame++) {
                  $stream.Write($frameHeader, 0, $frameHeader.Length)
                  $stream.Write($y, 0, $y.Length)
                  $stream.Write($u, 0, $u.Length)
                  $stream.Write($v, 0, $v.Length)
              }
          }
          finally {
              $stream.Dispose()
          }

          Write-Host "Synthetic fallback created:"
          Get-Item $video | Select-Object FullName, Length

      # ------------------------------------------------------------
      # Configure PGO GENERATE build
      #
      # IMPORTANT:
      # build already exists because the video is stored under
      # build/videos. Do NOT run "mkdir build" here.
      # ------------------------------------------------------------
      - name: Configure CMake - PGO Generate
        shell: pwsh
        run: |
          Set-Location build

          cmake .. `
            -G "Ninja" `
            -DCMAKE_BUILD_TYPE=Release `
            -DBUILD_SHARED_LIBS=OFF `
            -DBUILD_APPS=ON `
            -DBUILD_TESTING=OFF `
            -DSVT_AV1_PGO=ON `
            -DSVT_INTERNAL_PGO_GENERATE=ON `
            -DSVT_INTERNAL_PGO_USE=OFF `
            -DSVT_AV1_LTO=OFF `
            -DSVT_AV1_PGO_DIR="$PWD" `
            -DCMAKE_C_COMPILER=clang `
            -DCMAKE_CXX_COMPILER=clang++ `
            -DCMAKE_C_FLAGS="-march=x86-64" `
            -DCMAKE_CXX_FLAGS="-march=x86-64"

      # ------------------------------------------------------------
      # Build instrumented encoder
      # ------------------------------------------------------------
      - name: Build encoder with PGO instrumentation
        shell: pwsh
        run: |
          Set-Location build

          cmake --build . `
            --target SvtAv1EncApp `
            --parallel

      # ------------------------------------------------------------
      # Locate encoder
      # ------------------------------------------------------------
      - name: Locate instrumented encoder
        shell: pwsh
        run: |
          $exe = Get-ChildItem `
            -Path build `
            -Filter "SvtAv1EncApp.exe" `
            -Recurse `
            -File |
            Select-Object -First 1

          if (-not $exe) {
              Write-Error "SvtAv1EncApp.exe was not found."

              Write-Host "Available executables:"
              Get-ChildItem build -Recurse -Filter "*.exe" -File |
                Select-Object FullName

              exit 1
          }

          Write-Host "Encoder found:"
          Write-Host $exe.FullName

      # ------------------------------------------------------------
      # Run PGO training workload
      #
      # LLVM_PROFILE_FILE forces the raw profile into build/.
      # This avoids guessing where Clang writes .profraw.
      # ------------------------------------------------------------
      - name: Generate PGO profile data
        shell: pwsh
        run: |
          Set-Location build

          $exe = Get-ChildItem `
            -Path . `
            -Filter "SvtAv1EncApp.exe" `
            -Recurse `
            -File |
            Select-Object -First 1

          if (-not $exe) {
              Write-Error "SvtAv1EncApp.exe was not found."
              exit 1
          }

          Write-Host "Using encoder:"
          Write-Host $exe.FullName

          $env:LLVM_PROFILE_FILE = Join-Path $PWD "%m.profraw"

          Write-Host "LLVM_PROFILE_FILE=$env:LLVM_PROFILE_FILE"

          & $exe.FullName `
            -i "videos\park_joy_420_720p50.y4m" `
            -o NUL `
            --preset 3 `
            --enable-tf 2 `
            --tune 5 `
            2>&1 |
            Tee-Object -FilePath "profiling.log"

          if ($LASTEXITCODE -ne 0) {
              Write-Error "SvtAv1EncApp failed with exit code $LASTEXITCODE."
              exit $LASTEXITCODE
          }

          Write-Host ""
          Write-Host "Generated profile files:"

          $profiles = Get-ChildItem `
            -Path . `
            -Filter "*.profraw" `
            -File

          if (-not $profiles) {
              Write-Error "No .profraw files were generated."
              exit 1
          }

          $profiles |
            Select-Object FullName, Length

      # ------------------------------------------------------------
      # Merge LLVM profiles
      # ------------------------------------------------------------
      - name: Merge PGO profile data
        shell: pwsh
        run: |
          Set-Location build

          $profiles = Get-ChildItem `
            -Path . `
            -Filter "*.profraw" `
            -File

          if (-not $profiles) {
              Write-Error "No .profraw files found."
              exit 1
          }

          Write-Host "Merging profiles:"

          $profiles |
            ForEach-Object {
              Write-Host "  $($_.FullName)"
            }

          llvm-profdata merge `
            --sparse `
            $profiles.FullName `
            -o default.profdata

          if ($LASTEXITCODE -ne 0) {
              Write-Error "llvm-profdata merge failed."
              exit $LASTEXITCODE
          }

          if (-not (Test-Path "default.profdata")) {
              Write-Error "default.profdata was not created."
              exit 1
          }

          Write-Host ""
          Write-Host "Merged profile:"
          Get-Item default.profdata |
            Select-Object FullName, Length

      # ------------------------------------------------------------
      # Reconfigure for PGO USE + LTO
      # ------------------------------------------------------------
      - name: Configure CMake - PGO Use + LTO
        shell: pwsh
        run: |
          Set-Location build

          if (-not (Test-Path "default.profdata")) {
              Write-Error "default.profdata is missing."
              exit 1
          }

          cmake .. `
            -G "Ninja" `
            -DCMAKE_BUILD_TYPE=Release `
            -DBUILD_SHARED_LIBS=OFF `
            -DBUILD_APPS=ON `
            -DBUILD_TESTING=OFF `
            -DSVT_AV1_PGO=ON `
            -DSVT_INTERNAL_PGO_GENERATE=OFF `
            -DSVT_INTERNAL_PGO_USE=ON `
            -DSVT_AV1_PGO_DIR="$PWD" `
            -DSVT_AV1_LTO=ON `
            -DCMAKE_C_COMPILER=clang `
            -DCMAKE_CXX_COMPILER=clang++ `
            -DCMAKE_C_FLAGS="-march=x86-64 -flto -fuse-ld=lld" `
            -DCMAKE_CXX_FLAGS="-march=x86-64 -flto -fuse-ld=lld"

      # ------------------------------------------------------------
      # Build final optimized encoder
      # ------------------------------------------------------------
      - name: Build optimized binary with PGO + LTO
        shell: pwsh
        run: |
          Set-Location build

          cmake --build . `
            --target SvtAv1EncApp `
            --clean-first `
            --parallel

      # ------------------------------------------------------------
      # Find final executable
      # ------------------------------------------------------------
      - name: Verify final binary
        shell: pwsh
        run: |
          $exe = Get-ChildItem `
            -Path build `
            -Filter "SvtAv1EncApp.exe" `
            -Recurse `
            -File |
            Sort-Object Length -Descending |
            Select-Object -First 1

          if (-not $exe) {
              Write-Error "Final SvtAv1EncApp.exe was not found."

              Write-Host ""
              Write-Host "Available executables:"
              Get-ChildItem build -Recurse -Filter "*.exe" -File |
                Select-Object FullName, Length

              exit 1
          }

          Write-Host ""
          Write-Host "=========================================="
          Write-Host "Final SVT-AV1 encoder"
          Write-Host "=========================================="
          Write-Host "Path  : $($exe.FullName)"
          Write-Host "Size  : $($exe.Length) bytes"
          Write-Host "=========================================="

          Write-Host ""
          Write-Host "Testing encoder:"
          & $exe.FullName --help | Select-Object -First 20

          if ($LASTEXITCODE -ne 0) {
              Write-Error "Encoder test failed."
              exit $LASTEXITCODE
          }

      # ------------------------------------------------------------
      # Copy final binary to predictable artifact directory
      # ------------------------------------------------------------
      - name: Prepare artifact
        shell: pwsh
        run: |
          $exe = Get-ChildItem `
            -Path build `
            -Filter "SvtAv1EncApp.exe" `
            -Recurse `
            -File |
            Sort-Object Length -Descending |
            Select-Object -First 1

          if (-not $exe) {
              Write-Error "SvtAv1EncApp.exe was not found."
              exit 1
          }

          New-Item `
            -ItemType Directory `
            -Force `
            -Path "artifact" |
            Out-Null

          Copy-Item `
            $exe.FullName `
            "artifact\SvtAv1EncApp.exe" `
            -Force

          Write-Host "Artifact prepared:"
          Get-Item "artifact\SvtAv1EncApp.exe" |
            Select-Object FullName, Length

      # ------------------------------------------------------------
      # Upload final binary
      # ------------------------------------------------------------
      - name: Upload Windows x86-64 PGO + LTO binary
        uses: actions/upload-artifact@v4
        with:
          name: svt-av1-clang-windows-x86-64-pgo-lto
          path: artifact/SvtAv1EncApp.exe
          if-no-files-found: error
          retention-days: 7

      # ------------------------------------------------------------
      # Upload PGO diagnostic data
      # ------------------------------------------------------------
      - name: Upload PGO diagnostic artifacts
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: profiling-data-x86-64
          path: |
            build/profiling.log
            build/*.profraw
            build/*.profdata
          if-no-files-found: ignore
          retention-days: 3
```
